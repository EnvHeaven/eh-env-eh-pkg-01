{
  "Name": "install-revert-01",
  "Description": "Reinstall all EnvHeaven packages from the public npm registry globally. Used by `envheaven run install-revert` to undo a local dev global install.",
  "Author": "joveem (joveem@jovdev.com)",

  "Id": "envheaven-type-AUTO-FILL",
  "Version": "envheaven-type-AUTO-FILL-DYNAMIC",

  "EnvMapLayers": {
    "install-revert-01": {
      "fallback-list": ["default"],
      "Artifacts": {
        "envheaven-package-01": {
          "EnvMapName": "install-revert-01",
          "EnvVars": {
            "EH_DEPLOY_TARGET": "install-revert-01",
            "EH_DEPLOY_MODE": "registry-global-install"
          }
        },
        "envheaven-plugin-nodejs-pnpm-01": {
          "EnvMapName": "install-revert-01",
          "EnvVars": {
            "EH_DEPLOY_TARGET": "install-revert-01",
            "EH_DEPLOY_MODE": "registry-global-install"
          }
        },
        "envheaven-plugin-firebase-hosting-deploy-01": {
          "EnvMapName": "install-revert-01",
          "EnvVars": {
            "EH_DEPLOY_TARGET": "install-revert-01",
            "EH_DEPLOY_MODE": "registry-global-install"
          }
        },
        "envheaven-plugin-offiline-web-ui-01": {
          "EnvMapName": "install-revert-01",
          "EnvVars": {
            "EH_DEPLOY_TARGET": "install-revert-01",
            "EH_DEPLOY_MODE": "registry-global-install"
          }
        }
      }
    }
  }
}
