{
  "name": "@envheaven/plugins-aws-s3-cdn-deploy",
  "version": "0.1.0",
  "description": "EnvHeaven plugin for append-only AWS S3 CDN deployment. Supports inspect, diff, clone, and deploy-additions-only workflows.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "envheaven",
    "plugin",
    "aws",
    "s3",
    "cdn",
    "deploy",
    "append-only"
  ],
  "peerDependencies": {
    "envheaven": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "envheaven": {
      "optional": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "envheaven": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
