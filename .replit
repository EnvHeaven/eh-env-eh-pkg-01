modules = ["nodejs-24"]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]

[[workflows.workflow]]
name = "jd-eh-ws-fe-01: Angular Web App"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/jd-eh-ws-fe-01"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node start.js"
cwd = "../joveem-jd-env-eh-ws-01/artifacts/jd-eh-ws-fe-01"
waitForPort = 4200
router = "path"

[workflows.workflow.tasks.env]
PORT = "4200"
BASE_HREF = "/jd-eh-ws-fe-01/"
BASE_PATH = "/jd-eh-ws-fe-01/"

[[workflows.workflow]]
name = "jd-eh-ws-fe-api-01: Node REST API"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "console"
artifactId = "artifacts/jd-eh-ws-fe-api-01"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node start.js"
cwd = "../joveem-jd-env-eh-ws-01/artifacts/jd-eh-ws-fe-api-01"
waitForPort = 3000

[workflows.workflow.tasks.env]
PORT = "3000"
